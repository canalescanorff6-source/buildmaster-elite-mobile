{
  "name": "buildmaster-elite-tatico-v31-10-production",
  "version": "31.10.0",
  "private": true,
  "description": "BuildMaster v31.10 com Técnicos 2.0, Formações 2.0, Guia Tático Visual e Montagem Inteligente do Time.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "vercel-build": "next build --webpack",
    "sanitize:update-source": "node scripts/sanitize-update-source.mjs",
    "pretypecheck": "npm run sanitize:update-source",
    "pretest:all": "npm run sanitize:update-source",
    "pretest:v3000": "npm run sanitize:update-source",
    "preapk:build-web": "npm run sanitize:update-source",
    "test:npm-registry": "node scripts/verify-public-npm-registry.mjs",
    "quality:syntax": "node scripts/check-source-syntax.mjs",
    "quality:interactive": "node scripts/check-interactive-contracts.mjs",
    "quality:visual": "node scripts/check-visual-accessibility.mjs",
    "quality:bundle": "node scripts/check-bundle-budget.mjs",
    "quality:bundle-built": "node scripts/check-bundle-budget.mjs --built",
    "quality:audit": "node scripts/audit-project.mjs",
    "release:preflight": "node scripts/production-preflight.mjs",
    "release:play-preflight": "node scripts/validate-play-store-release.mjs",
    "integrity:generate": "node scripts/generate-integrity-manifest.mjs",
    "integrity:verify": "node scripts/verify-integrity-manifest.mjs",
    "typecheck:v3000": "tsc -p tests/types-v3000/tsconfig.json --pretty false && tsc -p tests/types-v3000/tsconfig-ui.json --pretty false",
    "test:v3000": "npm run typecheck:v3000 && node -r ./tests/_ts-require.cjs tests/v30-00-play-publication-regression.ts && node tests/v30-00-integrated-production-regression.mjs && node tests/v30-00-play-workflow-regression.mjs && npm run release:play-preflight && npm run quality:syntax && npm run quality:interactive && npm run release:preflight",
    "test:all": "npm run test:v3000 && npm run test:v3010 && npm run test:v3020 && npm run test:v3030 && npm run test:v3040 && npm run test:v3050 && npm run test:v3100 && npm run test:v3110 && npm run quality:audit",
    "apk:doctor": "npx cap doctor",
    "apk:add-android": "npx cap add android",
    "apk:sync": "npx cap sync android",
    "apk:open": "npx cap open android",
    "apk:build-web": "node scripts/build-static.mjs",
    "vendor:ocr": "node scripts/vendor-tesseract-assets.mjs",
    "test:v3010": "node -r ./tests/_ts-require.cjs tests/v30-10-world-fusion-regression.ts",
    "test:v3020": "npm run typecheck:v3020 && node -r ./tests/_ts-require.cjs tests/v30-20-local-ai-impeto-regression.ts",
    "typecheck:v3020": "tsc -p tests/types-v3020/tsconfig.json --pretty false",
    "typecheck:v3030": "tsc -p tests/types-v3030/tsconfig.json --pretty false",
    "test:v3030": "npm run typecheck:v3030 && node -r ./tests/_ts-require.cjs tests/v30-30-detailed-print-intelligence-regression.ts",
    "typecheck:v3040": "tsc -p tests/types-v3040/tsconfig.json --pretty false",
    "test:v3040": "npm run typecheck:v3040 && node -r ./tests/_ts-require.cjs tests/v30-40-smart-card-crop-regression.ts",
    "typecheck:v3050": "tsc -p tests/types-v3050/tsconfig.json --pretty false",
    "test:v3050": "npm run typecheck:v3050 && node -r ./tests/_ts-require.cjs tests/v30-50-ultra-precision-ocr-regression.ts && node -r ./tests/_ts-require.cjs tests/v30-50-typescript-hotfix-regression.ts",
    "typecheck:v3100": "tsc -p tests/types-v3100/tsconfig.json --pretty false",
    "test:v3100": "npm run typecheck:v3100 && node -r ./tests/_ts-require.cjs tests/v31-10-unified-intelligence-regression.ts",
    "typecheck:v3110": "tsc -p tests/types-v3110/tsconfig.json --pretty false && tsc -p tests/types-v3110-ui/tsconfig.json --pretty false",
    "test:v3110": "npm run typecheck:v3110 && node -r ./tests/_ts-require.cjs tests/v31-10-tactical-planning-regression.ts"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^5.1.1",
    "@capacitor/core": "^7.4.4",
    "@capacitor/android": "^7.4.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "@capacitor/cli": "^7.4.4"
  },
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
