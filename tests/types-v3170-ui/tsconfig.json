{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": "../..",
    "paths": {
      "@/lib/analyzer": [
        "tests/types-v3170-ui/analyzer-stub.ts"
      ],
      "@/modules/core/centralIntelligence": [
        "tests/types-v3170-ui/central-stub.ts"
      ],
      "@/modules/matches/matchRecorderBridge": [
        "tests/types-v3170-ui/recorder-stub.ts"
      ],
      "@/modules/matches/matchTrainerEngine": [
        "tests/types-v3170-ui/engine-stub.ts"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "types": [],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": [
    "stubs.d.ts",
    "analyzer-stub.ts",
    "central-stub.ts",
    "recorder-stub.ts",
    "engine-stub.ts",
    "../../src/modules/matches/MatchTrainerCenter.tsx"
  ]
}
