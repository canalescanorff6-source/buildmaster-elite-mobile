# BuildMaster v30.10 — variáveis públicas inseridas no build
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON_OU_PUBLISHABLE

# Distribuição: use "direct" no APK próprio e "play" no AAB da Google Play.
NEXT_PUBLIC_BUILDMASTER_DISTRIBUTION=direct

# Número numérico do projeto Google Cloud vinculado ao Play Integrity.
# O workflow Google Play lê a Variable GOOGLE_PLAY_CLOUD_PROJECT_NUMBER e a publica neste campo.
NEXT_PUBLIC_GOOGLE_PLAY_CLOUD_PROJECT_NUMBER=

# Canal beta opcional para a distribuição direta. O build Play ignora o atualizador por APK.
NEXT_PUBLIC_BUILDMASTER_UPDATE_BETA_URL=https://raw.githubusercontent.com/SEU_USUARIO/SEU_REPOSITORIO/buildmaster-update-beta/update-manifest.json

# Secrets somente de servidor/GitHub — nunca colocar em NEXT_PUBLIC_* nem no APK:
# GOOGLE_PLAY_UPLOAD_KEY_BUNDLE={"keystoreBase64":"...","storePassword":"...","keyAlias":"...","keyPassword":"..."}
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={...}
# BUILDMASTER_PRIVACY_HASH_SALT=VALOR_ALEATORIO_LONGO
# SUPABASE_SERVICE_ROLE_KEY=CONFIGURADA_APENAS_NO_SUPABASE
# Busca mundial automática (Secret de servidor/GitHub, não é variável pública):
# YOUTUBE_DATA_API_KEY=CONFIGURADA_NO_GITHUB_E_NO_SUPABASE
